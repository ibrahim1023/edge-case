ELEVENLABS_API_KEY=       # Required for TTS/STT/API calls
ELEVENLABS_AGENT_ID=      # Only needed if you use the Conversational AI widget
CONTEXT_DEV_API_KEY=      # Context.dev API key
CONTEXT_DEV_BASE_URL=https://api.context.dev/v1
DEVIN_TOKEN=              # Devin API token (starts with cog_)
DEVIN_ORG_ID=             # Devin organization ID (needed for real session runs)
DEVIN_BASE_URL=https://api.devin.ai/v3
GITHUB_TOKEN=             # Optional; classic or fine-grained token with public repo read is fine
SESSION_DB_PATH=          # Optional; defaults to ~/.edgecase/sessions.db
SESSION_TTL_SECONDS=86400 # Optional; session lifetime in seconds
